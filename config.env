# Base section options
KERNEL_SOURCE=https://github.com/itsaschoolbus-stuff/android_kernel_samsung_a52xq.git
KERNEL_SOURCE_BRANCH=ksu
KERNEL_CONFIG=a52xq_defconfig
KERNEL_ARCH=arm64
KERNEL_IMAGE_NAME=Image

# KernelSU section options
ENABLE_KERNELSU=true
KERNELSU_SETUP_SOURCE=https://raw.githubusercontent.com/rsuntk/KernelSU/main/kernel/setup.sh
KERNELSU_TAG=v1.0.5-83-legacy
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# Compiler section options
USE_CLANG=true
USE_LLVM_UTILS=true
CLANG_SOURCE=https://github.com/Neutron-Toolchains/clang-build-catalogue/releases/download/10032024/neutron-clang-10032024.tar.zst
CLANG_BRANCH=
USE_GCC=false
USE_GCC_64=true
GCC_64_SOURCE=
GCC_64_BRANCH=
USE_GCC_32=true
GCC_32_SOURCE=
GCC_32_BRANCH=

# Anykernel3 section options
USE_ANYKERNEL3=true
ANYKERNEL3_SOURCE=https://github.com/itsaschoolbus-stuff/AnyKernel3.git
ANYKERNEL3_BRANCH=a52xq

# Build section options
EXTRA_CMDS=CROSS_COMPILE=aarch64-linux-gnu- CONFIG_NO_ERROR_ON_MISMATCH=y TARGET_BUILD_VARIANT=user CONFIG_BUILD_ARM64_DT_OVERLAY=y DTC_EXT=$(pwd)/tools/dtc CONFIG_SECTION_MISMATCH_WARN_ONLY=y CONFIG_DEBUG_SECTION_MISMATCH=y KCFLAGS=-w
ENABLE_PYTHON2=true
REMOVE_UNUSED_PACKAGES=false
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=
